# Copier ce fichier en .env (jamais versionné) puis renseigner les valeurs
# depuis Supabase → Project Settings → API.

# URL du projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique « publishable » (sb_publishable_…).
# Les projets plus anciens peuvent utiliser à la place la clé « anon » :
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi…
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Sans ces deux variables, l'app démarre en « mode local » :
# données uniquement sur l'appareil, aucune synchronisation.
